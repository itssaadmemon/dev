#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install_dir="$root_dir/installs"
package_dir="$install_dir/packages"
pkg_config_dir="$package_dir/configs"

log() {
    echo "$*"
}

copy() {
    local src="$1" dest="$2"
    log "removing $dest"
    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"
    log "copying: $src"
    cp -rf "$src" "$dest"
}

list_choices() {
    local file="$1"
    grep -vE '^\s*$|^#' "$file"
}

copy_config() {
    local config="$1"

    case "$config" in
        zsh)
            copy "$pkg_config_dir/.zshrc" "$HOME/.zshrc"
            copy "$pkg_config_dir/.zsh_profile" "$HOME/.zsh_profile"
            ;;
        neovim)
            copy "$pkg_config_dir/nvim" "$HOME/.config/nvim"
            ;;
        i3)
            copy "$pkg_config_dir/i3" "$HOME/.config/i3"
            copy "$pkg_config_dir/i3status" "$HOME/.config/i3status"
            ;;
        *)
            if [[ -d "$pkg_config_dir/$config" ]]; then
                copy "$pkg_config_dir/$config" "$HOME/.config/$config"
            else
                log "no config found for: $config (skipping)"
            fi
            ;;
    esac
}

case "${1:-}" in
    upgrade)
        sudo apt -y update && sudo apt -y upgrade
        ;;

    base)
        sudo apt -y install luarocks ca-certificates wget unzip curl ninja-build gettext cmake build-essential git
        command -v gum >/dev/null 2>&1 || "$install_dir/gum"
        ;;

    packages)
        mapfile -t packages < <(list_choices "$install_dir/packages.txt")
        mapfile -t pkgs_choices < <(gum choose --no-limit "${packages[@]}")

        if [[ ${#pkgs_choices[@]} -gt 0 ]]; then
            for pkg in "${pkgs_choices[@]}"; do
                [[ -z "$pkg" ]] && continue
                log "Installing: $pkg"
                "$package_dir/$pkg"
                copy_config "$pkg"
            done
        fi
        ;;

    configs)
        mapfile -t config_packages < <(list_choices "$install_dir/configs.txt")
        mapfile -t config_choices < <(gum choose --no-limit "${config_packages[@]}")

        if [[ ${#config_choices[@]} -gt 0 ]]; then
            for config in "${config_choices[@]}"; do
                [[ -z "$config" ]] && continue
                log "Copying: $config"
                copy_config "$config"
            done
        fi
        ;;

    *)
        cat <<'EOF'
Usage: ./setup <command>

Commands:
  upgrade    apt update && apt upgrade
  base       install base build/runtime packages + gum
  packages   interactive package install (+ matching configs)
  configs    interactive config copy only
EOF
        ;;
esac
