#!/usr/bin/env bash
set -euo pipefail

font_dir="$HOME/.local/share/fonts/JetBrainsMono"
url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"
tmp="$(mktemp -d)"

release="$(curl -fsSLI -o /dev/null -w '%{url_effective}' 'https://github.com/ryanoasis/nerd-fonts/releases/latest')"
echo "Installing JetBrainsMono Nerd Font (${release##*/})..."

mkdir -p "$font_dir"
curl -fL --progress-bar -o "$tmp/JetBrainsMono.zip" "$url"
unzip -o -q "$tmp/JetBrainsMono.zip" -d "$font_dir"
rm -rf "$tmp"

if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$font_dir" >/dev/null
fi

echo "installed JetBrainsMono Nerd Font to $font_dir"
