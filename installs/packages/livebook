#!/usr/bin/env bash
set -euo pipefail

dest_dir="$HOME/.local/bin"
app="$dest_dir/livebook"
icon_dir="$HOME/.local/share/icons"
icon="$icon_dir/livebook.png"
applications_dir="$HOME/.local/share/applications"

arch="$(uname -m)"
case "$arch" in
    x86_64) arch="amd64" ;;
    aarch64 | arm64) arch="arm64" ;;
    *)
        echo "livebook: unsupported architecture: $arch" >&2
        exit 1
        ;;
esac

echo "Fetching latest Livebook release..."
tag="$(curl -fsSL https://api.github.com/repos/livebook-dev/livebook/releases/latest \
    | grep -oP '"tag_name":\s*"\K[^"]+')"
echo "Latest release: $tag"

mkdir -p "$dest_dir" "$icon_dir" "$applications_dir"

echo "Downloading Livebook-linux-${arch}.AppImage..."
curl -fL --progress-bar -o "$app" \
    "https://github.com/livebook-dev/livebook/releases/download/${tag}/Livebook-linux-${arch}.AppImage"
chmod +x "$app"

# Best-effort icon extraction from the AppImage.
if [[ ! -f "$icon" ]]; then
    tmpdir="$(mktemp -d)"
    (
        cd "$tmpdir"
        "$app" --appimage-extract 'usr/share/icons/*' >/dev/null 2>&1 || true
        found=""
        for pattern in '256x256@2/apps/livebook.png' '256x256/apps/livebook.png' '128x128/apps/livebook.png' 'livebook.png'; do
            found="$(find "$tmpdir/squashfs-root" -type f -iname "$(basename "$pattern")" -path "*${pattern%/*}*" -print -quit 2>/dev/null || true)"
            [[ -n "$found" ]] && break
        done
        if [[ -z "$found" ]]; then
            "$app" --appimage-extract >/dev/null 2>&1 || true
            found="$(find "$tmpdir/squashfs-root" -type f -iname 'livebook.png' -print -quit 2>/dev/null || true)"
        fi
        if [[ -n "$found" ]]; then
            cp "$found" "$icon"
        fi
    )
    rm -rf "$tmpdir"
fi

cat > "$applications_dir/livebook.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Livebook
Comment=Interactive notebooks for Elixir
Exec=$app
Icon=$icon
Terminal=false
Categories=Development;IDE;
EOF

update-desktop-database "$applications_dir" >/dev/null 2>&1 || true

echo "installed Livebook $tag to $app"
echo "launch from rofi (Alt+d), or run: livebook"
