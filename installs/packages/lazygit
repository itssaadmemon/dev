#!/usr/bin/env bash
set -euo pipefail

arch="$(uname -m)"
case "$arch" in
    x86_64) arch="x86_64" ;;
    aarch64 | arm64) arch="arm64" ;;
    *)
        echo "lazygit: unsupported architecture: $arch" >&2
        exit 1
        ;;
esac

version="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest \
    | grep -oP '"tag_name":\s*"\K[^"]+')"
tarball="/tmp/lazygit.tar.gz"

curl -fsSL -o "$tarball" \
    "https://github.com/jesseduffield/lazygit/releases/download/${version}/lazygit_${version#v}_Linux_${arch}.tar.gz"

sudo tar -C /usr/local/bin -xzf "$tarball" lazygit
rm -f "$tarball"

echo "installed lazygit ${version} to /usr/local/bin/lazygit"
