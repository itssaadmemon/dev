export XDG_CONFIG_HOME=$HOME/.config
VIM="nvim"

alias vim="nvim"

alias g="git"
alias gc="g clone"
alias gs="g status"
alias gi="g init"
alias ga="g add"
alias gct="g commit"
alias gph="g push"
alias gpl="g pull"
alias gr="git restore"
alias gb="git branch"
alias gco="git checkout"

alias doc="docker"
alias lzd='lazydocker'
alias lzg='lazygit'

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export GIT_EDITOR=$VIM
export DEV_CODE="$HOME/code"

eval "$(~/.local/bin/mise activate zsh)"

# opencode
export PATH=/home/thememondude/.opencode/bin:$PATH

# go bin
export PATH=$PATH:/usr/local/go/bin
# rustup
export PATH=$HOME/.cargo/bin:$PATH
