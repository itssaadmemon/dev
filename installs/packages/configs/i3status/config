# i3status configuration file.
# see "man i3status" for documentation.

general {
    colors = true
    interval = 5
    separator = "   "
    color_good = "#a6e3a1"
    color_degraded = "#f9e2af"
    color_bad = "#f38ba8"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

ethernet _first_ {
    format_up = "ETH %ip"
    format_down = ""
}

wireless _first_ {
    format_up = "WIFI %essid %quality"
    format_down = "WIFI off"
}

cpu_usage {
    format = "CPU %usage"
}

memory {
    format = "MEM %used"
    threshold_degraded = "1G"
    format_degraded = "MEM %used"
}

disk "/" {
    format = "DISK %avail"
}

battery all {
    format = "BAT %status %percentage"
    last_full_capacity = true
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}
